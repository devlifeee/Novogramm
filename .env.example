APP_ENV=development
SECRET_KEY=change-me-generate-with-python-secrets-token-hex
TOKEN_HASH_KEY=change-me-generate-a-different-random-secret
DEBUG=false

# Docker Compose: db. Local PostgreSQL: localhost.
USE_SQLITE=false
DATABASE_URL=
PG_HOST=db
PG_PORT=5432
PG_USER=novogramm_user
PG_PASSWORD=change-me-database-password
PG_DATABASE=novogramm_db
PG_SSLMODE=disable

CORS_ORIGINS=http://localhost:8888
FRONTEND_URL=http://localhost:8888
# Build-time public URL of the deployed API. Leave empty for local reverse proxy.
API_BASE_URL=
MAX_REQUEST_BYTES=6291456
SESSION_TTL_HOURS=168
# In Railway production, attach a Volume at /data/uploads and set this to /data/uploads.
# UPLOAD_FOLDER remains supported as a backwards-compatible fallback.
UPLOAD_DIR=

# Public v2 Checkbox site key. Configure this as an Appwrite Site build variable.
RECAPTCHA_SITE_KEY=
# Backend-only v2 Checkbox secret. Configure this only on Railway.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_DISABLED=true
SKIP_EMAIL_VERIFICATION=true
# Gmail API HTTPS email delivery. Use only the gmail.send scope when creating the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM=novogramm.corporation@gmail.com

# disabled | console (development only) | webhook
SMS_PROVIDER=disabled
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_FROM=Novogramm
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30
